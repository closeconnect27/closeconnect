# Supabase — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build links inside notification emails
NEXT_PUBLIC_SITE_URL=

# Recipient for claim/moderation notification emails
ADMIN_EMAIL=

# Supabase — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server-only
RESEND_API_KEY=

# Mixpanel — project token is safe to expose to the browser (like a GA id)
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Server-only — Basic Auth for the Import API, never prefix with NEXT_PUBLIC_
MIXPANEL_API_SECRET=

# Unsplash — server-only
UNSPLASH_ACCESS_KEY=

# Google Maps Platform — safe to expose to the browser, but MUST be
# restricted by HTTP referrer (your domain + localhost) in Google Cloud
# Console. Powers venue autocomplete + the event-page map. Leaving this
# blank is fine -- venue falls back to a plain text field and the map
# section just doesn't render.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Analytics 4 — safe to expose to the browser (like the Mixpanel
# token above). Leaving this blank just means no GA4 tracking, no error.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Identity Services client ID for the native/ID-token sign-in flow
# (src/app/login/page.tsx) -- same client ID already public in
# supabase/config.toml's [auth.external.google] section (client IDs aren't
# secrets, only the paired secret is). Used client-side to render Google's
# button and mint an ID token handed straight to supabase.auth.signInWithIdToken,
# never touching Supabase's own *.supabase.co redirect domain.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay Standard Checkout — server-only, never prefix either with
# NEXT_PUBLIC_. The key id (not the secret) is handed to the browser at
# payment time, but only via createRazorpayOrderForRegistration's own
# Server Action response -- never through an env var read client-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Giphy — client-embeddable key (expected/standard, not a secret), same
# key used on mobile for GIF search in chat. 100 requests/hr limit.
NEXT_PUBLIC_GIPHY_API_KEY=
