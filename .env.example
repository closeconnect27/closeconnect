# Supabase — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL used to build links inside notification emails
NEXT_PUBLIC_SITE_URL=

# Recipient for claim/moderation notification emails
ADMIN_EMAIL=

# Supabase — server-only, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Resend — server-only
RESEND_API_KEY=

# Razorpay — server-only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> your webhook's secret (not the API key secret)
RAZORPAY_WEBHOOK_SECRET=

# Mixpanel — project token is safe to expose to the browser (like a GA id)
NEXT_PUBLIC_MIXPANEL_TOKEN=
# Server-only — Basic Auth for the Import API, never prefix with NEXT_PUBLIC_
MIXPANEL_API_SECRET=
