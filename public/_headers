# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# Android App Links verification (Digital Asset Links) requires this exact
# content type -- Google's verifier rejects a response served as anything
# else, even though the file extension alone would usually be enough.
/.well-known/assetlinks.json
  Content-Type: application/json
